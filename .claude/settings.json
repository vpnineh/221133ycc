{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/setup-skills.sh\"",
            "timeout": 900
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/setup-claude-seo.sh\"",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"$(command -v graphify || echo \"$HOME/.local/bin/graphify\")\"; [ -x \"$G\" ] || exit 0; \"$G\" hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"$(command -v graphify || echo \"$HOME/.local/bin/graphify\")\"; [ -x \"$G\" ] || exit 0; \"$G\" hook-guard read --strict",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
