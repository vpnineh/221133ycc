# MetaQuotes-Demo tester costs (mq18 calibration), fixed-money swaps (SWAPM=3; the tester applies today's swap to all history).
# FX swaps in quote currency per lot (swq=1, MT5 'points' mode, converted at each rollover). tvm=0.1: that server reports
# metal tick value 10x too small (the EA sizes metals 10x, as in the tester). SPRT: broker spread history 2018-2026 from the journals.
PROFILE=CAL
SWAPM=3
DSHIFT=1
TZS=3
TZW=2
TIMER4=1
TICKSEC=1
SPRT=profiles/spr_MQ.csv
SPEC_XAUUSD=spread=0.12:comm=0:contract=100:swl=-12.6:sws=-4.6:tvm=0.1
SPEC_XAGUSD=spread=0.019:comm=0:contract=5000:swl=-11.5:sws=1.0:tvm=0.1
SPEC_US30=spread=1.33:comm=0:contract=1:swl=-2.2:sws=0:vstep=0.1:vmin=0.1
SPEC_NAS100=spread=1.12:comm=0:contract=1:swl=-0.82:sws=0:vstep=0.1:vmin=0.1
SPEC_SPX500=spread=0.47:comm=0:contract=1:swl=-0.31:sws=0:vstep=0.1:vmin=0.1
SPEC_USDJPY=spread=0.0046:comm=0:swl=-9.7:sws=0:swq=1
SPEC_AUDJPY=spread=0.012:comm=0:swl=560:sws=-1278:swq=1
SPEC_EURGBP=spread=0.00012:comm=0:swl=-1.20:sws=-0.40:swq=1
SPEC_GBPUSD=comm=0
