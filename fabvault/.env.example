# Canonical origin used for canonical URLs, hreflang, sitemap and JSON-LD.
SITE_URL=https://fabvault.pages.dev

# Amazon Associates tracking IDs (one per marketplace). Leave empty to emit untagged links.
PUBLIC_AMAZON_TAG_US=
PUBLIC_AMAZON_TAG_DE=
PUBLIC_AMAZON_TAG_ES=
PUBLIC_AMAZON_TAG_FR=
PUBLIC_AMAZON_TAG_JP=
PUBLIC_AMAZON_TAG_IT=
PUBLIC_AMAZON_TAG_NL=
PUBLIC_AMAZON_TAG_BR=

# Direct brand programmes: full query-string fragment appended to outbound links, e.g. "ref=fabvault".
PUBLIC_AFF_BAMBULAB=
PUBLIC_AFF_POLYMAKER=
PUBLIC_AFF_XTOOL=
PUBLIC_AFF_ELEGOO=
PUBLIC_AFF_SIRAYATECH=

# Google AdSense. Ads render only when the client id is set (format: ca-pub-0000000000000000).
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_INLINE=
PUBLIC_ADSENSE_SLOT_LEADERBOARD=
